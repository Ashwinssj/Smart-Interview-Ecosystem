# Smart Interview Ecosystem - Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# SUPABASE (Required)
# Get these from: https://supabase.com/dashboard/project/<your-project>/settings/api
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # Server-side only!

# ============================================
# GOOGLE GEMINI (Required for AI Services)
# Get API key from: https://makersuite.google.com/app/apikey
# ============================================
GOOGLE_API_KEY=your-google-gemini-api-key

# Model Configuration (Optional - defaults shown)
GEMINI_MODEL=gemini-1.5-pro
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# ============================================
# HEYGEN (Required for AI Mock Interviews)
# Get these from: https://heygen.com/streaming-avatar
# ============================================
HEYGEN_API_KEY=your-heygen-api-key
HEYGEN_AVATAR_ID=your-avatar-id
HEYGEN_VOICE_ID=your-voice-id

# ============================================
# FRONTEND (Optional)
# ============================================
NEXT_PUBLIC_HEYGEN_AVATAR_ID=your-avatar-id
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# AI SERVICES CONFIG (Optional - defaults shown)
# ============================================
ENVIRONMENT=development
LOG_LEVEL=INFO

# Resume Screening
RESUME_SCREENING_THRESHOLD=50
MAX_RESCREEN_ATTEMPTS=2

# Interview Settings
INTERVIEW_MAX_QUESTIONS=15
INTERVIEW_TIME_LIMIT_MINUTES=30